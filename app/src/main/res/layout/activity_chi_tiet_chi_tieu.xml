<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CHI TIẾT KHOẢN CHI"
            android:textColor="#173B70"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tên khoản chi"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtTenKhoanChi_245"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chưa có dữ liệu"
            android:textSize="18sp"
            android:paddingTop="8dp"
            android:paddingBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Số tiền"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtSoTien_245"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 VNĐ"
            android:textColor="#6B4EAA"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingTop="8dp"
            android:paddingBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ghi chú"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtGhiChu_245"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Không có ghi chú"
            android:textSize="16sp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp" />

        <Button
            android:id="@+id/btnQuayLai_245"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quay lại" />

    </LinearLayout>
</ScrollView>
